  <!-- Page Header -->
  <section class="pt-32 pb-16 bg-gradient-to-br from-primary via-primary-dark to-blue-900 text-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-extrabold mb-6">About Solvix</h1>
        <p class="text-xl md:text-2xl text-white/95 leading-relaxed">
          Building trusted partnerships through professional excellence and unwavering commitment to client success.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Corporate Overview -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="scroll-reveal max-w-5xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 text-center mb-6">Who We Are</h2>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed text-center mb-8">
          Solvix is a comprehensive business solutions firm that serves as a one-stop partner for organizations seeking professional support across multiple business functions. We specialize in providing end-to-end solutions that allow our clients to focus on their core competencies while we handle the operational complexities.
        </p>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed text-center">
          Our multi-disciplinary approach combines expertise in human resources, accounting, counseling, sales, marketing, technology, and operations to deliver integrated solutions that drive business growth and operational excellence.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Growth Journey -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-6 lg:px-12">
      <h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 text-center mb-6 scroll-reveal">Our Growth Journey</h2>
      <p class="text-lg md:text-xl text-gray-600 text-center max-w-3xl mx-auto mb-12 scroll-reveal">From Agra to Delhi NCR - A decade of excellence</p>
      
      <div class="scroll-reveal max-w-6xl mx-auto bg-white p-10 rounded-3xl shadow-2xl">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center p-6 md:border-r-2 border-gray-200">
            <div class="text-6xl text-primary font-extrabold mb-2">2015</div>
            <h3 class="text-2xl font-bold mb-3">Foundation</h3>
            <p class="text-gray-600">Started in Agra with a vision to provide professional business support services</p>
          </div>
          
          <div class="text-center p-6 md:border-r-2 border-gray-200">
            <div class="text-6xl text-primary font-extrabold mb-2">2020</div>
            <h3 class="text-2xl font-bold mb-3">Expansion</h3>
            <p class="text-gray-600">Extended operations to Delhi NCR, expanding service offerings and client base</p>
          </div>
          
          <div class="text-center p-6">
            <div class="text-6xl text-primary font-extrabold mb-2">2026</div>
            <h3 class="text-2xl font-bold mb-3">Leadership</h3>
            <p class="text-gray-600">Established as a trusted partner serving 500+ clients across multiple industries</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Mission & Vision -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        <div class="scroll-reveal bg-gradient-to-br from-primary to-primary-dark text-white p-10 rounded-3xl shadow-2xl">
          <div class="text-6xl mb-4">🎯</div>
          <h2 class="text-3xl md:text-4xl font-extrabold mb-6">Our Mission</h2>
          <p class="text-lg leading-relaxed text-white/95">
            To empower businesses with reliable, professional, and scalable support solutions that enable them to focus on growth while we handle operational excellence. We are committed to delivering consistent quality, ensuring business continuity, and building long-term partnerships based on trust and performance.
          </p>
        </div>
        
        <div class="scroll-reveal bg-white p-10 rounded-3xl shadow-2xl border-2 border-primary">
          <div class="text-6xl mb-4">🌟</div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-primary mb-6">Our Vision</h2>
          <p class="text-lg leading-relaxed text-gray-700">
            To be the most trusted business support partner across India, known for our commitment to quality, reliability, and client success. We envision a future where businesses of all sizes have access to professional support services that drive sustainable growth and operational efficiency.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Core Values -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-6 lg:px-12">
      <h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 text-center mb-6 scroll-reveal">Our Core Values</h2>
      <p class="text-lg md:text-xl text-gray-600 text-center max-w-3xl mx-auto mb-12 scroll-reveal">The principles that guide everything we do</p>
      
      <div class="stagger-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="stagger-item premium-card bg-white p-8 rounded-2xl shadow-lg border-t-4 border-primary">
          <div class="text-5xl mb-4">🤝</div>
          <h3 class="text-xl font-bold text-primary mb-3">Trust & Integrity</h3>
          <p class="text-gray-600 leading-relaxed">We build relationships based on honesty, transparency, and ethical business practices.</p>
        </div>
        
        <div class="stagger-item premium-card bg-white p-8 rounded-2xl shadow-lg border-t-4 border-primary">
          <div class="text-5xl mb-4">⭐</div>
          <h3 class="text-xl font-bold text-primary mb-3">Excellence</h3>
          <p class="text-gray-600 leading-relaxed">We strive for the highest standards in every service we deliver, continuously improving our processes.</p>
        </div>
        
        <div class="stagger-item premium-card bg-white p-8 rounded-2xl shadow-lg border-t-4 border-primary">
          <div class="text-5xl mb-4">🎯</div>
          <h3 class="text-xl font-bold text-primary mb-3">Client-Centric</h3>
          <p class="text-gray-600 leading-relaxed">Your success is our success. We tailor our solutions to meet your unique business needs.</p>
        </div>
        
        <div class="stagger-item premium-card bg-white p-8 rounded-2xl shadow-lg border-t-4 border-primary">
          <div class="text-5xl mb-4">💡</div>
          <h3 class="text-xl font-bold text-primary mb-3">Innovation</h3>
          <p class="text-gray-600 leading-relaxed">We embrace new technologies and methodologies to deliver cutting-edge solutions.</p>
        </div>
        
        <div class="stagger-item premium-card bg-white p-8 rounded-2xl shadow-lg border-t-4 border-primary">
          <div class="text-5xl mb-4">🔒</div>
          <h3 class="text-xl font-bold text-primary mb-3">Reliability</h3>
          <p class="text-gray-600 leading-relaxed">Consistent delivery, assured continuity, and dependable service you can count on.</p>
        </div>
        
        <div class="stagger-item premium-card bg-white p-8 rounded-2xl shadow-lg border-t-4 border-primary">
          <div class="text-5xl mb-4">🌱</div>
          <h3 class="text-xl font-bold text-primary mb-3">Growth Partnership</h3>
          <p class="text-gray-600 leading-relaxed">We grow with our clients, adapting our services to support their evolving needs.</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Why We Exist -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="scroll-reveal max-w-5xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6">Why Solvix Exists</h2>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-8">
          We recognized that businesses, especially SMEs and growing enterprises, face significant challenges in managing non-core functions while trying to scale. The burden of recruitment, payroll, compliance, and operational management often diverts focus from strategic growth initiatives.
        </p>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-8">
          Solvix was founded to bridge this gap—to provide businesses with access to professional, reliable support services that eliminate operational stress and enable them to concentrate on what they do best: growing their business.
        </p>
        <div class="bg-gray-50 p-8 rounded-2xl border-l-4 border-primary">
          <p class="text-xl md:text-2xl text-primary font-semibold italic">
            "We exist to make business operations simpler, more efficient, and more reliable for our clients."
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Operational Philosophy -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-6 lg:px-12">
      <h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 text-center mb-6 scroll-reveal">Our Operational Philosophy</h2>
      <p class="text-lg md:text-xl text-gray-600 text-center max-w-3xl mx-auto mb-12 scroll-reveal">How we deliver excellence consistently</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="scroll-reveal">
          <h3 class="text-2xl font-bold text-primary mb-4">Structured Processes</h3>
          <p class="text-gray-600 leading-relaxed">
            Every service we offer is backed by well-defined, documented processes that ensure consistency and quality across all client engagements.
          </p>
        </div>
        
        <div class="scroll-reveal">
          <h3 class="text-2xl font-bold text-primary mb-4">Dedicated Teams</h3>
          <p class="text-gray-600 leading-relaxed">
            We assign dedicated professionals to each client, ensuring deep understanding of your business and seamless service delivery.
          </p>
        </div>
        
        <div class="scroll-reveal">
          <h3 class="text-2xl font-bold text-primary mb-4">Continuous Improvement</h3>
          <p class="text-gray-600 leading-relaxed">
            We regularly review and enhance our services based on client feedback, industry best practices, and emerging technologies.
          </p>
        </div>
        
        <div class="scroll-reveal">
          <h3 class="text-2xl font-bold text-primary mb-4">Accountability & Transparency</h3>
          <p class="text-gray-600 leading-relaxed">
            Clear communication, regular reporting, and measurable outcomes define our client relationships.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-primary via-primary-dark to-blue-900 text-white">
    <div class="container mx-auto px-6 lg:px-12">
      <div class="max-w-4xl mx-auto text-center scroll-reveal">
        <h2 class="text-4xl md:text-5xl font-extrabold mb-6">Partner with Solvix</h2>
        <p class="text-xl md:text-2xl text-white/95 mb-8">
          Let's build a long-term partnership focused on your success.
